{
  "name": "cocora-royale-voxel",
  "version": "1.0.0",
  "description": "Battle Royale multijugador 3D voxel ambientado en el Valle del Cocora y Salento (Colombia) con Three.js, Node.js y Socket.IO",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "lint": "eslint .",
    "test": "node --test \"test/*.test.js\"",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.shared.json"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "typescript": "^5.9.3"
  }
}
